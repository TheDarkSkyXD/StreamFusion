{
  "name": "@streamfusion/integration-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-npm.mjs",
    "dev": "wrangler dev --env development",
    "start": "wrangler dev --env development",
    "build": "node ../../scripts/run-npm.mjs run typecheck && node ../../scripts/run-npm.mjs run deploy:dry-run",
    "deploy:development": "wrangler deploy --env development",
    "deploy:production": "wrangler deploy --env production",
    "deploy:dry-run": "node scripts/relay-dry-run.mjs",
    "lint": "eslint src/ tests/ scripts/ eslint.config.mjs vitest.config.mts --max-warnings=0 && prettier --check . --ignore-path ../../.gitignore --trailing-comma none",
    "test": "vitest run && node ../../scripts/run-npm.mjs run test:architecture && node ../../scripts/run-npm.mjs run test:environment-isolation && node ../../scripts/run-npm.mjs run test:secret-scan",
    "test:architecture": "node scripts/verify-architecture.mjs",
    "test:environment-isolation": "node scripts/verify-environments.mjs",
    "test:secret-scan": "node scripts/verify-secret-boundary.mjs",
    "pretypecheck": "node ../../scripts/run-npm.mjs run --prefix ../../packages/core build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@streamfusion/core": "file:../../packages/core"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "^17.8.0",
    "miniflare": "5.20260820.0-alpha",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "ajv@8.20.0": {
      "fast-uri": "3.1.8"
    },
    "miniflare@5.20260820.0-alpha": {
      "undici": "7.30.1"
    },
    "glob": "^10.4.5",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "rimraf": "^5.0.0",
    "tar": "^7.5.7",
    "tmp": "^0.2.5",
    "uuid": "11.1.1",
    "@npmcli/move-file": "npm:@npmcli/fs@^3.1.0",
    "cacache": "^18.0.0",
    "@napi-rs/wasm-runtime": "1.1.6",
    "@tanstack/router-core@1.171.26": {
      "seroval": "1.6.2",
      "seroval-plugins": "1.6.2"
    },
    "js-yaml@4.3.1": "4.3.2",
    "sharp": "0.35.5",
    "react": "19.2.8",
    "react-native": "0.86.3",
    "react-dom": "19.2.8",
    "handlebars": "4.7.10",
    "body-parser": "2.4.0",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  }
}
