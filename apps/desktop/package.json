{
  "name": "streamfusion",
  "private": true,
  "productName": "StreamFusion",
  "version": "1.0.0-beta.1",
  "description": "A unified desktop app for viewing Twitch and Kick streams",
  "author": "StreamFusion",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDarkSkyXD/StreamFusion.git"
  },
  "main": "./out/main/index.js",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.8.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.14.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.8.0 <12",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-npm.mjs",
    "install:electron": "install-electron",
    "rebuild-deps": "electron-builder install-app-deps",
    "rebuild-deps:x64": "electron-builder install-app-deps --arch=x64",
    "rebuild-deps:arm64": "electron-builder install-app-deps --arch=arm64",
    "package:x64": "electron-builder --publish never --x64",
    "package:arm64": "electron-builder --publish never --arm64",
    "package:windows:x64:signed": "electron-builder --win --x64 --publish never -c.forceCodeSigning=true",
    "package:macos:x64:signed": "electron-builder --mac --x64 --publish never -c.forceCodeSigning=true -c.mac.notarize=true",
    "package:macos:arm64:signed": "electron-builder --mac --arm64 --publish never -c.forceCodeSigning=true -c.mac.notarize=true",
    "dev": "cross-env STREAMFUSION_BROWSER_DEV=1 node scripts/start-dev.js",
    "dev:electron": "node scripts/start-dev.js",
    "dev:mcp": "node scripts/start-dev.js -- --remote-debugging-port=9222",
    "build": "electron-vite build",
    "start": "npm run start:checked",
    "start:checked": "npm run typecheck && npm run lint && node scripts/start-picker.js",
    "preview": "electron-vite preview",
    "dist": "npm run rebuild-deps && npm run build && electron-builder --publish never",
    "dist:win": "npm run rebuild-deps && npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run rebuild-deps && npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run rebuild-deps && npm run build && electron-builder --linux --publish never",
    "lint": "eslint src/ tests/ \"*.config.{js,mjs,cjs,jsx,ts,tsx}\"",
    "lint:fix": "eslint src/ --fix && prettier --write src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run --project=node --project=dom",
    "test:node": "vitest run --project=node",
    "test:dom": "vitest run --project=dom",
    "test:system": "vitest run --project=system-windows",
    "test:all": "npm test && npm run test:system",
    "test:benchmark": "node scripts/benchmark-test-suite.mjs",
    "test:watch": "vitest --project=node --project=dom",
    "test:coverage": "vitest run --project=node --project=dom --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:coverage": "node scripts/check-storybook-coverage.mjs",
    "architecture:features": "node scripts/migrate-source-layout.mjs --check && node scripts/migrate-renderer-features.mjs --check && node scripts/verify-feature-boundaries.mjs",
    "parity:desktop:write": "node scripts/desktop-parity-inventory.mjs write",
    "parity:desktop:check": "node scripts/desktop-parity-inventory.mjs check",
    "reliability:boundaries": "node scripts/check-reliability-boundaries.mjs",
    "bundle:analyze": "cross-env ANALYZE=true npm run build",
    "perf:soak": "node scripts/performance-soak.mjs"
  },
  "build": {
    "appId": "com.streamfusion.app",
    "productName": "StreamFusion",
    "icon": "assets/icons/icon",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "assets/icons/icon.ico",
      "assets/icons/icon.png",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!**/CHANGELOG*",
      "!**/LICENSE*",
      "!**/README*"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "StreamFusion"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3",
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@iarna/toml": "^2.2.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "axios": "^1.18.1",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-util": "^1.0.0",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.6.16",
    "html-entities": "^2.6.0",
    "ky": "^2.0.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.27.0",
    "pusher-js": "^8.6.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.11",
    "reconnecting-websocket": "^4.4.0",
    "sonner": "^2.0.7",
    "svg-loaders-react": "^3.1.1",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.9",
    "tmi.js": "^1.8.5",
    "twitch-gql-queries": "^0.1.25",
    "update-electron-app": "^3.3.0",
    "ws": "8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
