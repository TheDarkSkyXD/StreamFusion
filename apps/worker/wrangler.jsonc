{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "streamfusion",
    "main": "src/index.ts",
    "compatibility_date": "2024-02-15",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "ratelimits": [
        {
            "name": "KICK_AUTH_IP_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 30,
                "period": 60
            }
        },
        {
            "name": "KICK_AUTH_SUBJECT_RATE_LIMITER",
            "namespace_id": "1002",
            "simple": {
                "limit": 6,
                "period": 60
            }
        }
    ],
    "observability": {
        "enabled": true
    }
}
