{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamFusion Mobile production signing certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicationId",
    "certificateSha256",
    "recordedBy",
    "recordedAt",
    "notes"
  ],
  "properties": {
    "applicationId": {
      "const": "com.thedarkskyxd.streamfusion"
    },
    "certificateSha256": {
      "description": "Lowercase hex SHA-256 certificate fingerprint, or null while no production signer is authorized.",
      "type": ["string", "null"],
      "pattern": "^([0-9a-f]{64}|null)$"
    },
    "recordedBy": {
      "type": ["string", "null"]
    },
    "recordedAt": {
      "description": "ISO 8601 date the fingerprint was pinned.",
      "type": ["string", "null"],
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|null)$"
    },
    "notes": {
      "type": "string"
    }
  }
}
