{
  "cli": {
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": false,
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      }
    },
    "alpha": {
      "developmentClient": false,
      "distribution": "internal",
      "autoIncrement": false,
      "node": "22.14.0",
      "env": {
        "npm_config_strict_allow_scripts": "false",
        "npm_config_allow_git": "all",
        "npm_config_allow_remote": "all",
        "npm_config_allow_file": "all",
        "npm_config_allow_directory": "all"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "internal",
      "autoIncrement": false,
      "node": "22.14.0",
      "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57",
      "env": {
        "STREAMFUSION_RELEASE_CHANNEL": "production",
        "npm_config_strict_allow_scripts": "false",
        "npm_config_allow_git": "all",
        "npm_config_allow_remote": "all",
        "npm_config_allow_file": "all",
        "npm_config_allow_directory": "all"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}