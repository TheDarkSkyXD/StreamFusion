{
  "name": "@streamfusion/mobile",
  "private": true,
  "version": "0.1.14",
  "main": "index.js",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-npm.mjs",
    "start": "react-native start --port 8083",
    "android": "node scripts/start-development-client.mjs",
    "android:native": "node scripts/run-android.mjs",
    "bundle:android": "node scripts/bundle-android.mjs",
    "build:android:development": "node scripts/build-android-development.mjs",
    "config:android": "node scripts/resolve-production-config.mjs",
    "config:android:production": "node scripts/resolve-production-config.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "lint": "eslint .storybook/ src/ modules/ scripts/ tests/ index.js native-config.cjs babel.config.js metro.config.js react-native.config.js eslint.config.mjs vitest.config.mts --max-warnings=0",
    "test": "node --test tests/*.test.mjs && vitest run --config vitest.config.mts && node scripts/verify-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "verify:storybook": "node scripts/verify-storybook.mjs"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.0",
    "@streamfusion/core": "0.0.0",
    "@tanstack/react-query": "5.101.4",
    "i18next": "26.4.0",
    "lucide-react-native": "1.35.0",
    "query-string": "9.5.0",
    "react": "19.2.8",
    "react-i18next": "17.0.12",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "7.27.1",
    "@eslint/js": "9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-native-web-vite": "10.5.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "14.0.0",
    "jsdom": "30.0.1",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "react-dom": "19.2.8",
    "react-native-web": "0.21.3",
    "sharp": "0.35.4",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
