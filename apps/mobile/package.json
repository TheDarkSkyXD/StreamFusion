{
  "name": "@streamfusion/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-npm.mjs",
    "start": "expo start --go",
    "android": "node scripts/start-expo-go.mjs",
    "android:native": "node scripts/run-android.mjs",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "bundle:android": "expo export --platform android --output-dir dist",
    "build:android:development": "node scripts/build-android-development.mjs",
    "config:android": "expo config --type public --json",
    "lint": "eslint app/ scripts/ tests/ vendor/ metro.config.js eslint.config.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/verify-architecture.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "57.0.17",
    "expo-build-properties": "57.0.15",
    "expo-constants": "57.0.15",
    "expo-dev-client": "57.0.16",
    "expo-linking": "57.0.8",
    "expo-router": "57.0.17",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "query-string": "9.5.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "eslint": "10.9.1",
    "eslint-config-expo": "57.0.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
