{
  "name": "@streamfusion/mobile",
  "private": true,
  "version": "0.1.8",
  "main": "expo-router/entry",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-npm.mjs",
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "node scripts/start-development-client.mjs",
    "android:native": "node scripts/run-android.mjs",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "bundle:android": "expo export --platform android --output-dir dist",
    "build:android:development": "node scripts/build-android-development.mjs",
    "config:android": "expo config --type public --json",
    "config:android:production": "node scripts/resolve-production-config.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "lint": "eslint .storybook/ app/ src/ modules/ scripts/ tests/ vendor/ app.config.js metro.config.js eslint.config.mjs vitest.config.mts --max-warnings=0",
    "test": "node --test tests/*.test.mjs && vitest run --config vitest.config.mts && node scripts/verify-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "node ../../scripts/eas-build-pre-install.mjs",
    "storybook": "storybook dev -p 6007 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "verify:storybook": "node scripts/verify-storybook.mjs"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.0",
    "@streamfusion/core": "0.0.0",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.17",
    "expo-build-properties": "57.0.15",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.15",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.16",
    "expo-file-system": "57.0.2",
    "expo-haptics": "57.0.3",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.8",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "57.0.1",
    "expo-notifications": "57.0.17",
    "expo-router": "57.0.17",
    "expo-screen-orientation": "57.0.2",
    "expo-secure-store": "57.0.2",
    "expo-splash-screen": "57.0.8",
    "expo-sqlite": "57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "i18next": "26.4.0",
    "lucide-react-native": "1.35.0",
    "query-string": "9.5.0",
    "react": "19.2.8",
    "react-i18next": "17.0.12",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-native-web-vite": "10.5.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-boundaries": "7.2.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react-dom": "19.2.8",
    "react-native-web": "0.21.3",
    "sharp": "0.35.4",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
