{
  "expo": {
    "name": "StreamFusion Development",
    "slug": "streamfusion-development",
    "version": "0.1.0-alpha.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "scheme": "streamfusion-development",
    "newArchEnabled": true,
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "package": "com.thedarkskyxd.streamfusion.dev",
      "versionCode": 2,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "streamfusion.leveluptogetherbiz.workers.dev",
              "pathPrefix": "/auth/kick/android/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "backgroundColor": "#1a1a1a"
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-router",
      "./plugins/with-picture-in-picture",
      "./plugins/with-no-draw-over-apps",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-sqlite",
        {
          "android": {
            "useSQLCipher": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0f0f0f",
          "defaultChannel": "live"
        }
      ],
      "expo-system-ui",
      "expo-video",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "backgroundColor": "#1a1a1a",
    "androidNavigationBar": {
      "backgroundColor": "#1a1a1a",
      "barStyle": "light-content"
    }
  }
}
