{
  "expo": {
    "name": "StreamFusion Development",
    "slug": "streamfusion-development",
    "version": "0.1.0",
    "platforms": ["android"],
    "scheme": "streamfusion-development",
    "newArchEnabled": true,
    "android": {
      "allowBackup": false,
      "package": "com.thedarkskyxd.streamfusion.dev",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-sqlite",
        {
          "android": {
            "useSQLCipher": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
