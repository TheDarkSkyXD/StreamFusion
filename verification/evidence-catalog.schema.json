{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheDarkSkyXD/StreamFusion/blob/main/verification/evidence-catalog.schema.json",
  "title": "StreamFusion Android evidence catalog",
  "description": "Versioned evidence records keyed by Desktop capability ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "verifierVersion",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyVersion": {
      "const": 1
    },
    "verifierVersion": {
      "const": "1.0.0"
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/evidenceRecord"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceCommit",
        "apkDigest",
        "verifierVersion",
        "testVersion",
        "environment",
        "device",
        "artifacts",
        "result",
        "observedAt",
        "expiresAt",
        "links"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "apkDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifierVersion": {
          "type": "string",
          "minLength": 1
        },
        "testVersion": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "device": {
          "$ref": "#/$defs/device"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "result": {
          "enum": ["pass", "fail", "quarantined", "infrastructure-failure"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "retention", "name"],
      "properties": {
        "gate": {
          "enum": ["change", "main", "candidate", "public-release"]
        },
        "retention": {
          "enum": ["development", "main", "release"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profile", "apiLevel"],
      "properties": {
        "kind": {
          "enum": ["none", "emulator", "physical"]
        },
        "profile": {
          "type": ["string", "null"]
        },
        "apiLevel": {
          "type": ["integer", "null"],
          "minimum": 30
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "mediaType"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
