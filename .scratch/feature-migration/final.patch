-  private async getOfficialApiBearerToken(): Promise<string | null> {
-    if (kickAuthService.isAuthenticated()) {
-      await kickAuthService.ensureValidToken();
-      const userToken = kickAuthService.getAccessToken();
-      if (userToken) {
-        return userToken;
-      }
-    }
-
-    return null;
-  }
