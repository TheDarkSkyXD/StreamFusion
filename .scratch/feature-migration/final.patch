+    | "sub"
+    | "resub"
+    | "subgift"
+    | "submysterygift"
+    | "raid"
+    | "ritual"
+    | "bitsbadgetier";
+  readonly userId: string;
+  readonly username: string;
+  readonly displayName: string;
+  readonly color?: string;
+  readonly message?: string;
+  readonly systemMessage: string;
