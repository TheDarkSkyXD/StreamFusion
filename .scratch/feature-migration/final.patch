+  type StreamsByGameIdData = {
+    game: null | {
+      id: string;
+      streams: null | {
+        edges: { cursor: string; node: DirectoryPageGameStream; __typename: string }[];
+        pageInfo: { hasNextPage: boolean };
+      };
+    };
+  };
