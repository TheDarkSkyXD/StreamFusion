+      const timeoutSignal = AbortSignal.timeout(15000);
+      const signal = callerSignal ? AbortSignal.any([callerSignal, timeoutSignal]) : timeoutSignal;
+      const res: Response = await net.fetch(url, {
+        method,
+        headers,
+        body: body ?? undefined,
+        signal,
+      });
