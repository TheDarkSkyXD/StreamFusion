-  if (options.liveOnly) {
-    channels = channels.filter((ch) => ch.isLive);
-  }
-
-  const { isIntegrityRejected } = processGqlSearchErrors("SearchChannels", errors);
-
-  return buildPaginatedResult(
-    "SearchChannels",
-    channels,
