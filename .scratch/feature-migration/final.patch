+        />
+      </div>
+      <div className="rounded-md border border-[#303034] bg-[#18181b]">
+        <ChannelEngagement
+          key={state}
+          broadcasterId="123"
+          channel="fixture"
+          access={access}
+          requestScopes={() => {}}
+        />
+      </div>
+    </div>
+  );
+}
