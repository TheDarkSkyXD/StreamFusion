+      // and the server returns zero streams.
+      broadcasterLanguages: options.language ? [options.language.toUpperCase()] : [],
+      freeformTags: [],
+      sort: "VIEWER_COUNT",
+    },
+    slug,
+    sortTypeIsRecency: false,
