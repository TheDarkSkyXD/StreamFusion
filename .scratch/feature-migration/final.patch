+function extractLoginFromPreviewUrl(url: string): string {
+  const match = /(?:^|\/)live_user_([a-z0-9_]+)(?:-[^/?#.]*)?\.[a-z0-9]+(?:[?#].*)?$/i.exec(url);
+  return match?.[1] ?? "";
