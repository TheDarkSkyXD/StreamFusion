diff --git a/apps/desktop/src/frontend/features/moderation/components/screens/Mod/channel/workspace/StreamInfoTool.tsx b/apps/desktop/src/frontend/features/moderation/components/screens/Mod/channel/workspace/StreamInfoTool.tsx
