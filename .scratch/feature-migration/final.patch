+const startSchema = z
+  .object({
+    feedId: z.string().trim().min(1).max(128),
+    userId: z.string().trim().min(1).max(64),
+    channelId: z.string().trim().min(1).max(64),
+    eventTypes: z
+      .array(
+        z.enum([
