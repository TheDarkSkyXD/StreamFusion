+  getVideoPlaybackUrl(request: {
+    platform: Platform;
+    videoId: string;
+  }): Promise<IpcResult<{ url: string }>>;
+  getClipPlaybackUrl(request: {
+    platform: Platform;
+    clipId: string;
+    thumbnailUrl?: string;
+    clipUrl?: string;
+  }): Promise<IpcResult<{ url: string; format: string }>>;
+}
