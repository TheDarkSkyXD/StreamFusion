+    { status: 500, kind: "network" },
+  ])("preserves $status failure without a second write", async ({ status, kind }) => {
+    const request = vi
+      .fn()
+      .mockResolvedValueOnce(
+        new Response(JSON.stringify({ message: "rejected" }), {
+          status,
+          headers: { "Retry-After": "30" },
