+                        <DropdownMenu.Trigger asChild>
+                          <button
+                            type="button"
+                            className="mod-workspace-icon-button"
+                            aria-label={t("moderation.workspace.options", {
+                              defaultValue: "{{title}} panel options",
+                              title: widget.title,
