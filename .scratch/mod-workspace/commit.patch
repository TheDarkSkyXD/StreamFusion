+.mod-workspace {
+  --mod-accent: #9146ff;
+  --mod-accent-soft: #9146ff55;
+  --mod-focus: #bf94ff;
+  --mod-on-accent: #fff;
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  min-width: 0;
+  gap: 8px;
+  color: #efeff1;
+  background: #0e0e10;
+  font-size: 14px;
+}
+.mod-workspace[data-platform="kick"],
+.mod-workspace-menu[data-platform="kick"] {
+  --mod-accent: #53fc18;
+  --mod-accent-soft: #53fc1833;
+  --mod-focus: #53fc18;
+  --mod-on-accent: #0e0e10;
+}
+.mod-workspace.dragging,
+.mod-workspace.dragging * {
+  cursor: grabbing !important;
+}
+.mod-workspace-dock {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  flex: 0 0 56px;
+  gap: 8px;
+  padding: 10px 0;
+  background: #18181b;
+  overflow-y: auto;
+}
+.mod-workspace-dock-button {
+  display: flex;
+  flex: 0 0 36px;
+  width: 36px;
+  align-items: center;
+  justify-content: center;
+  border-radius: 4px;
+  color: #adadb8;
+}
+.mod-workspace-dock-button[aria-pressed="true"] {
+  color: var(--mod-accent);
+  background: #2f2f35;
+}
+.mod-workspace-dock-button:hover:not(:disabled),
+.mod-workspace-icon-button:hover {
+  color: #fff;
+  background: #3a3a3d;
+}
+.mod-workspace-dock-button:disabled {
+  opacity: 0.35;
+}
+.mod-workspace-dock-spacer {
+  flex: 1;
+}
+.mod-workspace-main {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  padding: 8px 8px 8px 0;
+}
+.mod-workspace-canvas {
+  position: relative;
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+}
+.mod-workspace-widget {
+  position: absolute;
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  background: #18181b;
+  overflow: hidden;
+  border-radius: 3px;
+}
+.mod-workspace-widget-header {
+  display: flex;
+  flex: 0 0 40px;
+  align-items: center;
+  padding-right: 6px;
+  background: #252529;
+  gap: 2px;
+}
+.mod-workspace-widget-handle {
+  touch-action: none;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex: 1;
+  min-width: 0;
+  height: 100%;
+  padding: 0 10px;
+  user-select: none;
+}
+.mod-workspace-widget-handle.draggable {
+  cursor: grab;
+}
+.mod-workspace-widget-handle.draggable:active {
+  cursor: grabbing;
+}
+.mod-workspace-widget-handle > svg {
+  flex-shrink: 0;
+  width: 16px;
+  height: 16px;
+}
+.mod-workspace-widget-handle h2 {
+  font-size: 13px;
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.mod-workspace-grip {
+  margin-left: auto;
+  opacity: 0.35;
+}
+.mod-workspace-icon-button {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 26px;
+  height: 28px;
+  border-radius: 3px;
+  flex-shrink: 0;
+  color: #adadb8;
+}
+.mod-workspace-widget-body {
+  flex: 1;
+  min-height: 0;
+  min-width: 0;
+  overflow: auto;
+  padding: 12px;
+}
+.mod-workspace-widget-body.live {
+  padding: 0;
+  overflow: hidden;
+}
+.mod-workspace-widget-body > section > h2:first-child {
+  display: none;
+}
+.mod-workspace-drop-target {
+  pointer-events: none;
+  position: absolute;
+  inset: 0;
+  z-index: 10;
+}
+.mod-workspace-drop-preview {
+  position: absolute;
+  background: var(--mod-accent-soft);
+  border: 2px solid var(--mod-focus);
+  pointer-events: none;
+}
+.mod-workspace-separator {
+  position: absolute;
+  touch-action: none;
+  z-index: 20;
+  border-radius: 2px;
+}
+.mod-workspace-separator.vertical {
+  cursor: col-resize;
+}
+.mod-workspace-separator.horizontal {
+  cursor: row-resize;
+}
+.mod-workspace-separator:hover,
+.mod-workspace-separator:focus-visible {
+  background: var(--mod-accent);
+  outline: none;
+}
+.mod-workspace button:focus-visible,
+.mod-workspace-widget:focus-visible {
+  outline: 2px solid var(--mod-focus);
+  outline-offset: -2px;
+}
+.mod-workspace-menu {
+  min-width: 150px;
+  padding: 4px;
+  background: #252529;
+  border: 1px solid #53535f;
+  border-radius: 4px;
+  color: #efeff1;
+  box-shadow: 0 4px 20px #0008;
+  z-index: 100;
+  font-size: 13px;
+}
+.mod-workspace-menu-item {
+  padding: 6px 10px;
+  border-radius: 3px;
+  cursor: pointer;
+  outline: none;
+}
+.mod-workspace-menu-item[data-highlighted] {
+  background: var(--mod-accent, #9146ff);
+  color: var(--mod-on-accent, #fff);
+}
+.mod-workspace-canvas.narrow {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  overflow-y: auto;
+}
+.mod-workspace-canvas.narrow .mod-workspace-widget {
+  position: relative;
+  flex: 0 0 360px;
+  width: 100%;
+}
+.mod-workspace-canvas.narrow .mod-workspace-widget[data-widget-id="chat"] {
+  flex-basis: 500px;
+}
+@media (prefers-reduced-motion: reduce) {
+  .mod-workspace * {
+    scroll-behavior: auto;
+  }
+}
