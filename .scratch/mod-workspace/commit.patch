+                      className={`mod-workspace-widget-handle ${!layout.locked && !narrow && !isPinnedWidget(widget.id) ? "draggable" : ""}`}
+                      data-drag-handle={
+                        !layout.locked && !narrow && !isPinnedWidget(widget.id) ? "true" : undefined
+                      }
+                      onPointerDown={(event) => {
+                        if (
+                          layout.locked ||
+                          narrow ||
+                          isPinnedWidget(widget.id) ||
+                          event.button !== 0
+                        )
+                          return;
+                        event.preventDefault();
+                        container.current?.setPointerCapture(event.pointerId);
+                        dragGesture.current = {
+                          id: widget.id,
+                          x: event.clientX,
+                          y: event.clientY,
+                          active: false,
+                        };
+                      }}
+                    >
+                      {widget.icon}
+                      <h2>{widget.title}</h2>
+                      {!layout.locked && !isPinnedWidget(widget.id) && (
+                        <GripVertical size={14} className="mod-workspace-grip" />
+                      )}
+                    </div>
+                    {!layout.locked && !isPinnedWidget(widget.id) && (
