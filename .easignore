# EAS Build archive ignores (monorepo root). Keep upload lean for apps/mobile.

# Dependencies - reinstalled on EAS
**/node_modules/

# VCS / local scratch
.git/
.scratch/
**/.expo/
**/.turbo/
**/.cache/

# Generated native project + local Android build outputs (CNG/prebuild on EAS)
apps/mobile/android/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/app/.cxx/
**/android/.kotlin/

# Desktop build outputs (keep package.json for npm workspaces)
apps/desktop/out/
apps/desktop/release/
apps/desktop/dist/
apps/desktop/.scratch-icon-package/

# Evidence, artifacts, local smoke
pc-smoke-evidence/
**/pc-smoke-evidence/
artifacts/
**/dist/
**/release/
**/*.apk
**/*.aab
**/*.jks
**/*.keystore
**/*.exe
**/*.blockmap
**/*.zip

# Tests / IDE
**/coverage/
**/.vitest/
**/.idea/
**/.vscode/
**/*.log