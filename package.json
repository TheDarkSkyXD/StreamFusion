{
  "name": "streamfusion-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.8.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.14.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.8.0 <12",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260820.1": true
  },
  "scripts": {
    "preinstall": "node scripts/require-npm.mjs",
    "start": "npm run --workspace streamfusion start:checked",
    "desktop": "npm run --workspace streamfusion start:checked",
    "build": "npm run --workspace streamfusion build",
    "dist": "npm run --workspace streamfusion dist",
    "dist:win": "npm run --workspace streamfusion dist:win",
    "dist:mac": "npm run --workspace streamfusion dist:mac",
    "dist:linux": "npm run --workspace streamfusion dist:linux",
    "install:dependencies": "npm ci --ignore-scripts && npm run lint:dependencies && npm run lint:release-age && npm run audit:signatures && npm run audit:dependencies && npm run rebuild:dependencies",
    "rebuild:dependencies": "npm rebuild better-sqlite3 electron-winstaller esbuild ffmpeg-static fsevents workerd --ignore-scripts=false && npm run --workspace streamfusion install:electron",
    "audit:signatures": "npm audit signatures",
    "audit:dependencies": "npm audit --audit-level=high",
    "lint": "npm run lint:dependencies && npm run lint:lockfile && npm run --workspace streamfusion lint",
    "lint:dependencies": "node scripts/validate-dependency-sources.mjs",
    "lint:lockfile": "eslint --config eslint.lockfile.config.mjs package-lock.json package.json \"apps/*/package.json\" && npm run lint:release-age",
    "lint:release-age": "node scripts/validate-lockfile-release-age.mjs",
    "test": "npm run --workspace streamfusion test && npm run --workspace streamfusion-worker test",
    "test:all": "npm run --workspace streamfusion test:all && npm run --workspace streamfusion-worker test",
    "test:package-policy": "node --test scripts/package-policy.test.mjs scripts/validate-lockfile-release-age.test.mjs",
    "test:release-policy": "node --test scripts/release-policy.test.mjs scripts/merge-artifacts.test.mjs scripts/release-workflow.test.mjs",
    "typecheck": "npm run --workspace streamfusion typecheck && npm run --workspace streamfusion-worker typecheck",
    "perf:soak": "npm run --workspace streamfusion perf:soak"
  },
  "overrides": {
    "ajv@8.20.0": {
      "fast-uri": "3.1.5"
    },
    "glob": "^10.4.5",
    "rimraf": "^5.0.0",
    "tar": "^7.5.7",
    "tmp": "^0.2.5",
    "@npmcli/move-file": "npm:@npmcli/fs@^3.1.0",
    "cacache": "^18.0.0",
    "@napi-rs/wasm-runtime": "1.1.6",
    "@tanstack/router-core@1.171.26": {
      "seroval": "1.6.2",
      "seroval-plugins": "1.6.2"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-lockfile": "^2.1.0",
    "js-yaml": "^5.2.2",
    "pacote": "21.5.1",
    "ws": "8.21.3"
  }
}
