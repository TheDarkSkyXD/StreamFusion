{
  "name": "@streamfusion/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.8.0 <12"
  },
  "exports": {
    "./platform": {
      "types": "./src/platform/index.ts",
      "default": "./src/platform/index.ts"
    },
    "./content": {
      "types": "./src/content/index.ts",
      "default": "./src/content/index.ts"
    },
    "./discovery": {
      "types": "./src/discovery/index.ts",
      "default": "./src/discovery/index.ts"
    },
    "./follows": {
      "types": "./src/follows/index.ts",
      "default": "./src/follows/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./chat": {
      "types": "./src/chat/index.ts",
      "default": "./src/chat/index.ts"
    },
    "./activity": {
      "types": "./src/activity/index.ts",
      "default": "./src/activity/index.ts"
    },
    "./reliability": {
      "types": "./src/reliability/index.ts",
      "default": "./src/reliability/index.ts"
    },
    "./relay": {
      "types": "./src/relay/index.ts",
      "default": "./src/relay/index.ts"
    },
    "./media-jobs": {
      "types": "./src/media-jobs/index.ts",
      "default": "./src/media-jobs/index.ts"
    },
    "./local-captions": {
      "types": "./src/local-captions/index.ts",
      "default": "./src/local-captions/index.ts"
    },
    "./display-language": {
      "types": "./src/display-language/index.ts",
      "default": "./src/display-language/index.ts"
    },
    "./settings": {
      "types": "./src/settings/index.ts",
      "default": "./src/settings/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "eslint src/ tests/*.mjs scripts/ eslint.config.mjs --max-warnings=0 && prettier --check . --ignore-path ../../.gitignore",
    "test": "node --test tests/*.test.mjs src/features/*/tests/*.test.mjs && node ../../scripts/run-npm.mjs run test:architecture",
    "test:architecture": "node scripts/verify-architecture.mjs && node ../../scripts/verify-core-import-policy.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "ajv@8.20.0": {
      "fast-uri": "3.1.8"
    },
    "miniflare@5.20260820.0-alpha": {
      "undici": "7.30.1"
    },
    "glob": "^10.4.5",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "rimraf": "^5.0.0",
    "tar": "^7.5.7",
    "tmp": "^0.2.5",
    "uuid": "11.1.1",
    "@npmcli/move-file": "npm:@npmcli/fs@^3.1.0",
    "cacache": "^18.0.0",
    "@napi-rs/wasm-runtime": "1.1.6",
    "@tanstack/router-core@1.171.26": {
      "seroval": "1.6.2",
      "seroval-plugins": "1.6.2"
    },
    "js-yaml@4.3.1": "4.3.2",
    "sharp": "0.35.5",
    "react": "19.2.8",
    "react-native": "0.86.3",
    "react-dom": "19.2.8",
    "handlebars": "4.7.10",
    "body-parser": "2.4.0",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.14.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  }
}
